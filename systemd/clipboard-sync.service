[Unit]
Description=Clipboard Sync (Mac <-> Linux)
After=network.target graphical-session.target

[Service]
ExecStart=%h/bin/clipboard-receiver
Restart=always
RestartSec=5

# Wayland セッションへのアクセスに必要
# XDG_RUNTIME_DIR は systemd user service では自動設定される
# WAYLAND_DISPLAY が見つからない場合は以下をアンコメントして調整
# Environment=WAYLAND_DISPLAY=wayland-0

# Linux -> Mac 方向の送信を有効にする場合に設定（Mac の Tailscale IP）
# Environment=CLIPBOARD_SYNC_MAC_HOST=100.x.x.x
# Environment=CLIPBOARD_SYNC_MAC_PORT=8766

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
