<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.clipboard-sync</string>

    <key>ProgramArguments</key>
    <array>
        <!-- ビルド後のバイナリパスに書き換える -->
        <string>/Users/YOUR_USERNAME/workspaces/github.com/haradashinya/clipboard-sync/mac-sender/.build/release/clipboard-sender</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Linux 側の Tailscale IP またはホスト名 -->
        <key>CLIPBOARD_SYNC_HOST</key>
        <string>YOUR_LINUX_TAILSCALE_IP</string>
        <key>CLIPBOARD_SYNC_PORT</key>
        <string>8765</string>
    </dict>

    <!-- ログイン時に自動起動 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- クラッシュ時に自動再起動 -->
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/clipboard-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/clipboard-sync.err</string>
</dict>
</plist>
